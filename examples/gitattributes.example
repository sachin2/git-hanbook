# Example .gitattributes — copy to your repo root as .gitattributes

# Normalise line endings: LF in the repo, sensible defaults on checkout
* text=auto eol=lf

# Windows scripts need CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# HDL / constraints / scripts: always LF
*.v    text eol=lf
*.sv   text eol=lf
*.vhd  text eol=lf
*.xdc  text eol=lf
*.sdc  text eol=lf
*.tcl  text eol=lf
*.sh   text eol=lf

# Binary: never diff/merge as text
*.png  binary
*.jpg  binary
*.pdf  binary
*.zip  binary
*.bit  binary
*.bin  binary
*.dcp  binary
*.gds  binary
*.oas  binary

# Large files via Git LFS (requires `git lfs install`)
# *.bit filter=lfs diff=lfs merge=lfs -text
# *.gds filter=lfs diff=lfs merge=lfs -text

# Exclude from `git archive`
.github/     export-ignore
tests/       export-ignore
.gitattributes export-ignore

# Generated files: collapse in GitHub diffs, keep out of language stats
# generated/** linguist-generated=true
